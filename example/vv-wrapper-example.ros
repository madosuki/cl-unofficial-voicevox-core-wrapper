(in-package :ros.script.vv-wrapper-example.3899604745)

(defun write-wav-file (&key filepath wav-bytes wav-length)
  (with-open-file (stream filepath
                          :direction :output
                          :if-exists :supersede
                          :element-type 'unsigned-byte)
    (dotimes (n wav-length)
      (let ((byte (aref wav-bytes n)))
        (when byte
          (write-byte byte stream))))))

(defun parse-option (argv)
  (let ((tmp-text-option (member "--text" argv :test #'equal))
        (tmp-lib-core-path-option (member "--lib-core-path" argv :test #'equal))
        (tmp-lib-onnxruntime-path-option (member "--lib-onnxruntime-path" argv :test #'equal))
        (tmp-open-jtalk-dict-dir-path-option (member "--open-jtalk-dict-dir-path" argv :test #'equal))
        (tmp-speaker-id-option (member "--speaker-id" argv :test #'equal)))
    (print argv)
    (if (or (null tmp-text-option)
            (null tmp-lib-core-path-option)
            (null tmp-lib-onnxruntime-path-option)
            (null tmp-open-jtalk-dict-dir-path-option))
        nil
        (let ((speaker-id-integer (if tmp-speaker-id-option
                                      (parse-integer (cadr tmp-speaker-id-option) :junk-allowed t)
                                      nil)))
          (if speaker-id-integer
              (list
               :text (cadr tmp-text-option)
               :lib-core-path (cadr tmp-lib-core-path-option)
               :lib-onnxruntime (cadr tmp-lib-onnxruntime-path-option)
               :open-jtalk-dict-dir-path (cadr tmp-open-jtalk-dict-dir-path-option)
               :speaker-id speaker-id-integer)
              (list
               :text (cadr tmp-text-option)
               :lib-core-path (cadr tmp-lib-core-path-option)
               :lib-onnxruntime (cadr tmp-lib-onnxruntime-path-option)
               :open-jtalk-dict-dir-path (cadr tmp-open-jtalk-dict-dir-path-option)))))))

(defmacro with-open-libs (lib-core-path lib-onnxruntime-path &body body)
  `(unwind-protect
        (progn
          (load-library ,lib-core-path)
          (load-library ,lib-onnxruntime-path)
          ,@body)
     (progn
       (close-library ,lib-core-path)
       (close-library ,lib-onnxruntime-path))))

(defun main (&rest argv)
  (declare (ignorable argv))
  (let ((parsed (parse-option argv)))
    (unless parsed
      (format t "require --text and --lib-core-path , --lib-onnxruntime-path and --open-jtalk-dict-dir-path. --speaker-id is optionaly.~%")
      (return-from main nil))
    (let* ((text (cadr (member :text parsed)))
           (lib-core-path (cadr (member :lib-core-path parsed)))
           (lib-onnxruntime-path (cadr (member :lib-onnxruntime parsed)))
           (open-jtalk-dict-dir-path (cadr (member :open-jtalk-dict-dir-path parsed)))
           (speaker-id (cadr (member :speaker-id parsed))))
      (unless speaker-id
        (setq speaker-id 0))
      (load-library lib-core-path)
      (load-library lib-onnxruntime-path)
      (format t "version: ~A~%" (cl-unofficial-voicevox-core-wrapper:get-version))
      ;; (with-open-libs lib-core-path lib-onnxruntime-path
