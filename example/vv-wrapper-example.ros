#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  #+quicklisp(ql:quickload '(:jonathan :cl-unofficial-voicevox-core-wrapper) :silent t)
  )

(defpackage :ros.script.vv-wrapper-example.3899604745
  (:use :cl :jonathan :cl-unofficial-voicevox-core-wrapper)
  (:import-from :cl-unofficial-voicevox-core-wrapper
           :load-library
           :close-library))
(in-package :ros.script.vv-wrapper-example.3899604745)

(defun write-wav-file (&key filepath wav-bytes wav-length)
  (with-open-file (stream filepath
                          :direction :output
                          :if-exists :supersede
                          :if-does-not-exist :create
                          :element-type '(unsigned-byte 8))
    (dotimes (n wav-length)
      (write-byte (aref wav-bytes n) stream))))

(defun option-value (name argv &optional default)
  (let ((option (member name argv :test #'equal)))
    (if option
        (cadr option)
        default)))

(defun parse-option (argv)
  (let ((text (option-value "--text" argv))
        (lib-core-path (option-value "--lib-core-path" argv))
        (lib-onnxruntime-path (option-value "--lib-onnxruntime-path" argv))
        (open-jtalk-dict-dir-path (option-value "--open-jtalk-dict-dir-path" argv))
        (vvm-path (option-value "--vvm-path" argv))
        (output-file (option-value "--output-file" argv "output.wav"))
        (speaker-id (parse-integer (option-value "--speaker-id" argv "0") :junk-allowed t)))
    (if (or (null text)
            (null lib-core-path)
            (null lib-onnxruntime-path)
            (null open-jtalk-dict-dir-path)
            (null vvm-path)
            (null speaker-id))
        nil
        (list
         :text text
         :lib-core-path lib-core-path
         :lib-onnxruntime lib-onnxruntime-path
         :open-jtalk-dict-dir-path open-jtalk-dict-dir-path
         :vvm-path vvm-path
         :output-file output-file
         :speaker-id speaker-id))))

(defmacro with-open-libs (lib-core-path lib-onnxruntime-path &body body)
  `(unwind-protect
        (progn
          (load-library ,lib-core-path)
          (load-library ,lib-onnxruntime-path)
          ,@body)
     (progn
       (close-library ,lib-core-path)
       (close-library ,lib-onnxruntime-path))))

(defun require-ok (result context)
  (unless (eq result :voicevox-result-ok)
    (error "~A failed: ~A (~A)"
           context
           result
           (cl-unofficial-voicevox-core-wrapper:error-result-to-message result))))

(defmacro with-close ((var close-form) &body body)
  `(let (,var)
     (unwind-protect
          (progn ,@body)
       (when ,var
         ,close-form))))

(defun main (&rest argv)
  (declare (ignorable argv))
  (let ((parsed (parse-option argv)))
    (unless parsed
      (format t "require --text, --lib-core-path, --lib-onnxruntime-path, --open-jtalk-dict-dir-path and --vvm-path. --speaker-id and --output-file are optional.~%")
      (return-from main nil))
    (let* ((text (cadr (member :text parsed)))
           (lib-core-path (cadr (member :lib-core-path parsed)))
           (lib-onnxruntime-path (cadr (member :lib-onnxruntime parsed)))
           (open-jtalk-dict-dir-path (cadr (member :open-jtalk-dict-dir-path parsed)))
           (vvm-path (cadr (member :vvm-path parsed)))
           (output-file (cadr (member :output-file parsed)))
           (speaker-id (cadr (member :speaker-id parsed))))
      (format t "onnxruntime lib path: ~A~%" lib-onnxruntime-path)
      (with-open-libs lib-core-path lib-onnxruntime-path
        (format t "version: ~A~%" (cl-unofficial-voicevox-core-wrapper:get-version))
        (with-close (open-jtalk (open-jtalk-rc-close open-jtalk))
          (with-close (voice-model-file (voice-model-file-close voice-model-file))
            (with-close (voicevox (voicevox-synthesizer-delete voicevox))
              (let ((onnxruntime (make-instance 'onnxruntime-class))
                    (open-jtalk-instance (make-instance 'open-jtalk-rc-class))
                    (voice-model-file-instance (make-instance 'voice-model-file-class))
                    (voicevox-instance (make-instance 'voicevox-class)))
                (cl-unofficial-voicevox-core-wrapper:onnxruntime-set-filename-to-options onnxruntime lib-onnxruntime-path)
                (require-ok (onnxruntime-init onnxruntime) "onnxruntime-init")
                (require-ok (open-jtalk-rc-init open-jtalk-instance open-jtalk-dict-dir-path)
                            "open-jtalk-rc-init")
                (setf open-jtalk open-jtalk-instance)
                (require-ok (voicevox-synthesizer-init voicevox-instance onnxruntime open-jtalk)
                            "voicevox-synthesizer-init")
                (setf voicevox voicevox-instance)
                (require-ok (voice-model-file-open voice-model-file-instance vvm-path)
                            "voice-model-file-open")
                (setf voice-model-file voice-model-file-instance)
                (require-ok (voicevox-synthesizer-load-voice-model voicevox voice-model-file)
                            "voicevox-synthesizer-load-voice-model")
                (multiple-value-bind (result wav-bytes wav-length)
                    (voicevox-synthesizer-tts voicevox text speaker-id)
                  (require-ok result "voicevox-synthesizer-tts")
                  (write-wav-file :filepath output-file
                                  :wav-bytes wav-bytes
                                  :wav-length wav-length)
                  (format t "wrote: ~A (~A bytes)~%" output-file wav-length))))))))))
;;; vim: set ft=lisp lisp:
